                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "type": "object"
              },
              "handler": {
                "default": "index.handler",
                "description": "Entry point the runtime calls",
                "minLength": 1,
                "type": "string"
              },
              "runtime": {
