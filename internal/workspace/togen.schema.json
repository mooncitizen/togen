{
  "$id": "https://togen.dev/schema/togen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "outDir": {
      "description": "Directory the generated code is written to",
      "minLength": 1,
      "type": "string"
    },
    "style": {
      "additionalProperties": false,
      "description": "How the studio draws the diagram",
      "properties": {
        "kinds": {
          "additionalProperties": false,
          "description": "Style for every node of a type",
          "patternProperties": {
            "^(service|function|database|gateway|queue|bucket|cache)$": {
              "additionalProperties": false,
              "properties": {
                "color": {
                  "description": "Fill colour as #rrggbb",
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "type": "string"
                },
                "icon": {
                  "anyOf": [
                    {
                      "enum": [
                        "aws/api-gateway",
                        "aws/ecs",
                        "aws/elasticache",
                        "aws/lambda",
                        "aws/rds",
                        "aws/s3",
                        "aws/sqs",
                        "azure/api-management",
                        "azure/cache-redis",
                        "azure/container-apps",
                        "azure/database-postgresql",
                        "azure/functions",
                        "azure/service-bus",
                        "azure/storage-blob",
                        "gcp/api-gateway",
                        "gcp/cloud-functions",
                        "gcp/cloud-run",
                        "gcp/cloud-sql",
                        "gcp/cloud-storage",
                        "gcp/memorystore",
                        "gcp/pubsub"
                      ],
                      "type": "string"
                    },
                    {
                      "pattern": "^\\.\\.?/.+$",
                      "type": "string"
                    }
                  ],
                  "description": "A bundled icon id such as aws/rds or a path relative to togen.yml"
                },
                "shape": {
                  "description": "Outline the node is drawn with",
                  "enum": [
                    "card",
                    "cylinder",
                    "hexagon",
                    "circle"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "nodes": {
          "additionalProperties": false,
          "description": "Style for one node by name",
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "additionalProperties": false,
              "properties": {
                "color": {
                  "description": "Fill colour as #rrggbb",
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "type": "string"
                },
                "icon": {
                  "anyOf": [
                    {
                      "enum": [
                        "aws/api-gateway",
                        "aws/ecs",
                        "aws/elasticache",
                        "aws/lambda",
                        "aws/rds",
                        "aws/s3",
                        "aws/sqs",
                        "azure/api-management",
                        "azure/cache-redis",
                        "azure/container-apps",
                        "azure/database-postgresql",
                        "azure/functions",
                        "azure/service-bus",
                        "azure/storage-blob",
                        "gcp/api-gateway",
                        "gcp/cloud-functions",
                        "gcp/cloud-run",
                        "gcp/cloud-sql",
                        "gcp/cloud-storage",
                        "gcp/memorystore",
                        "gcp/pubsub"
                      ],
                      "type": "string"
                    },
                    {
                      "pattern": "^\\.\\.?/.+$",
                      "type": "string"
                    }
                  ],
                  "description": "A bundled icon id such as aws/rds or a path relative to togen.yml"
                },
                "shape": {
                  "description": "Outline the node is drawn with",
                  "enum": [
                    "card",
                    "cylinder",
                    "hexagon",
                    "circle"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "theme": {
          "default": "dark",
          "description": "Colour scheme the studio opens with",
          "enum": [
            "dark",
            "light",
            "system"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "targets": {
      "description": "Code generators to run",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "usage": {
      "additionalProperties": false,
      "description": "Usage of one node by name, or of the network",
      "patternProperties": {
        "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
          "additionalProperties": false,
          "properties": {
            "durationMs": {
              "description": "Milliseconds one run of a function takes",
              "minimum": 0,
              "type": "number"
            },
            "egressGb": {
              "description": "Gigabytes a bucket or service sends to the internet a month",
              "minimum": 0,
              "type": "number"
            },
            "invocations": {
              "description": "Times a function runs (a rate)",
              "pattern": "^[0-9]+(\\.[0-9]+)?[kM]?/(min|hour|day|month)$",
              "type": "string"
            },
            "messages": {
              "description": "Messages a queue carries (a rate)",
              "pattern": "^[0-9]+(\\.[0-9]+)?[kM]?/(min|hour|day|month)$",
              "type": "string"
            },
            "natGb": {
              "description": "Gigabytes the network's NAT gateway processes a month",
              "minimum": 0,
              "type": "number"
            },
            "requests": {
              "description": "Requests a gateway serves or a bucket takes (a rate)",
              "pattern": "^[0-9]+(\\.[0-9]+)?[kM]?/(min|hour|day|month)$",
              "type": "string"
            },
            "storageGb": {
              "description": "Gigabytes a bucket holds over the month",
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "version": {
      "description": "File format version",
      "minimum": 1,
      "type": "integer"
    }
  },
  "title": "Togen configuration",
  "type": "object"
}
