{
  "version": 1,
  "name": "shop",
  "provider": "gcp",
  "region": "europe-west2",
  "environment": "dev",
  "nodes": [
    { "id": "gateway-1", "type": "gateway", "name": "api" },
    {
      "id": "function-1",
      "type": "function",
      "name": "orders",
      "properties": { "runtime": "node", "handler": "index.handler", "env": { "LOG_LEVEL": "info" } }
    },
    {
      "id": "database-1",
      "type": "database",
      "name": "orders-db",
      "properties": { "engine": "postgres", "size": "small" }
    },
    {
      "id": "function-2",
      "type": "function",
      "name": "worker",
      "properties": { "runtime": "node", "handler": "index.handler" }
    },
    {
      "id": "service-1",
      "type": "service",
      "name": "notifier",
      "properties": { "image": "nginx:1.27", "port": 8080 }
    },
    { "id": "queue-1", "type": "queue", "name": "jobs" }
  ],
  "edges": [
    {
      "id": "edge-1",
      "from": "gateway-1",
      "to": "function-1",
      "relation": "routes",
      "properties": { "path": "/orders", "methods": ["GET", "POST"] }
    },
    { "id": "edge-2", "from": "function-1", "to": "database-1", "relation": "reads" },
    { "id": "edge-3", "from": "function-1", "to": "queue-1", "relation": "publishes" },
    { "id": "edge-4", "from": "function-2", "to": "queue-1", "relation": "consumes" },
    { "id": "edge-5", "from": "service-1", "to": "queue-1", "relation": "consumes" }
  ]
}
